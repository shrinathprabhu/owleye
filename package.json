{
  "name": "owleye",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=26.2.0 <27"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "redeploy": "node scripts/redeploy.mjs",
    "update": "node scripts/update.mjs",
    "build": "pnpm --filter @owleye/console build && cargo build --release --locked -p owleye-api",
    "build:sdk": "pnpm --filter @owleye/analytics build",
    "test:sdk": "pnpm --filter @owleye/analytics test",
    "typecheck": "pnpm --filter @owleye/console typecheck"
  }
}
